{
  "name": "hackernews",
  "description": "Search Hacker News posts and comments via Algolia API. No auth required.",
  "intel_action": "hackernews",
  "auth": "none",
  "rate_limit_per_min": 60,
  "timeout_ms": 8000,
  "parameters": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "description": "Search keywords." },
      "tags": { "type": "string", "description": "Filter tags, e.g. 'story', 'comment', 'show_hn'." },
      "hits_per_page": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
    },
    "required": ["query"]
  }
}
