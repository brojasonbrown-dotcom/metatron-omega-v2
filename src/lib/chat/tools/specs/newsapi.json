{
  "name": "newsapi",
  "description": "Top headlines or full-text article search via NewsAPI. Requires NEWSAPI_KEY (configured).",
  "intel_action": "newsapi",
  "auth": "newsapi_key",
  "rate_limit_per_min": 30,
  "timeout_ms": 10000,
  "parameters": {
    "type": "object",
    "properties": {
      "endpoint": { "type": "string", "enum": ["top", "everything"], "default": "top" },
      "q": { "type": "string", "description": "Search keywords (required for endpoint=everything)." },
      "country": { "type": "string", "description": "ISO 3166-1 alpha-2 country code (top headlines only)." },
      "category": { "type": "string", "enum": ["business", "entertainment", "general", "health", "science", "sports", "technology"] },
      "page_size": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
    }
  }
}
